DATABASE_URL=postgres://postgres:postgres@localhost:5432/appraisals
BETTER_AUTH_SECRET=change-me-to-a-random-32+-char-string
BETTER_AUTH_URL=http://localhost:3000
# Photo storage. Leave S3_BUCKET empty in dev to store photos under ./.uploads.
# In production use S3 or Cloudflare R2 (S3-compatible); the bucket needs a CORS rule allowing PUT from your app origin.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
